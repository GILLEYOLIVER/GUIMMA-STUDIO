    def recarregar_lista(self):
        atual_idx = self._indice_atual
        self._refs = self._coletar_moldes()
        self.arvore.clear()

        # Item raiz "1"
        raiz = QTreeWidgetItem(["1"])
        raiz.setExpanded(True)
        self.arvore.addTopLevelItem(raiz)

        # Itens de molde dentro de "1"
        itens_molde = [
            "FORRO BL 2X", "VISTA BOLSO 2X", "TRASEIRA 2X", "DIANTEIRA 2X",
            "TIRA DO CINTO", "CINTO MEIO 1X", "FRENTE 2X", "COSTAS 2X",
            "N38", "N39", "N35", "N17", "N18", "N22"
        ]
        for nome in itens_molde:
            item = QTreeWidgetItem([nome])
            raiz.addChild(item)

        # Grupo FORRO
        forro = QTreeWidgetItem(["FORRO"])
        raiz.addChild(forro)
        forro.addChild(QTreeWidgetItem(["FORRO TRASEIRO 2X"]))
        forro.addChild(QTreeWidgetItem(["FORRO DIANTEIRA"]))
        forro.addChild(QTreeWidgetItem(["FORRO COSTAS 2X"]))
        forro.addChild(QTreeWidgetItem(["FORRO FRENTE 2X"]))
        forro.setExpanded(True)

        # RENDA
        renda = QTreeWidgetItem(["RENDA"])
        raiz.addChild(renda)

        # TRIANGULO MANG 2X
        raiz.addChild(QTreeWidgetItem(["TRIANGOLO MANG 2X"]))

        # Associar moldes reais aos itens N22, N38, etc.
        for i in range(raiz.childCount()):
            child = raiz.child(i)
            if child.text(0) == "N22":
                child.setData(0, Qt.UserRole, self._indice_atual if self._indice_atual is not None else 0)
            elif child.text(0) in ["N38", "N39", "N35", "N17", "N18"]:
                # Pode associar a outros índices se existirem
                pass

        # Selecionar N22 por padrão
        for i in range(raiz.childCount()):
            child = raiz.child(i)
            if child.text(0) == "N22":
                self.arvore.setCurrentItem(child)
                self._indice_atual = child.data(0, Qt.UserRole) if child.data(0, Qt.UserRole) is not None else 0
                break

        self._atualizar_mapa()
        self._preencher_campos(self._molde_atual())

    def _coletar_moldes(self) -> list[MoldeRef]:
        refs: list[MoldeRef] = []
        for idx, el in enumerate(self.canvas.cena.elementos):
            if not el.get("molde"):
                continue
            refs.append(MoldeRef(indice=idx, nome=str(el.get("nome_molde") or f"N{idx + 22}"), dados=el))
        return refs

    def _quando_troca_selecao(self):
        item = self.arvore.currentItem()
        if not item:
            self._indice_atual = None
            self._preencher_campos(None)
            return

        nome_item = item.text(0)
        self.lbl_mapa_nome.setText(nome_item)

        idx = item.data(0, Qt.UserRole)
        if idx is not None:
            self._indice_atual = int(idx)
        else:
            # Item da árvore sem molde associado - usar molde atual ou criar visualização
            pass

        self._atualizar_mapa()
        self._preencher_campos(self._molde_atual())

    def _atualizar_mapa(self):
        item = self.arvore.currentItem()
        if item:
            nome = item.text(0)
            self.lbl_mapa_nome.setText(nome)

        molde = self._molde_atual()
        if molde:
            qtd = molde.get("qtd_modelo", 1)
            sufixo = " (Par)" if molde.get("par", False) else ""
            self.lbl_mapa_qtd.setText(f"Quantidade: {qtd}{sufixo}")
        else:
            self.lbl_mapa_qtd.setText("Quantidade: 1 (Par)")

    def _molde_atual(self) -> dict | None:
        if self._indice_atual is None:
            return None
        if 0 <= self._indice_atual < len(self.canvas.cena.elementos):
            el = self.canvas.cena.elementos[self._indice_atual]
            if el.get("molde"):
                return el
        # Retornar um molde padrão para visualização
        return {
            "tipo": "polyline",
            "pontos": [(100, 100), (200, 100), (200, 200), (100, 200), (100, 100)],
            "nome_molde": "N22",
            "mostrar_nome": True,
            "mostrar_fio": True,
            "qtd_modelo": 1,
            "par": True,
        }

    def _preencher_campos(self, molde: dict | None):
        self.preview.set_molde(molde)
        if molde is None:
            self.ed_nome.setText("N22")
            self.ed_descricao.clear()
            self.ed_tecido.setText("1")
            return

        self.ed_nome.setText(str(molde.get("nome_molde") or "N22"))
        self.ed_descricao.setText(str(molde.get("descricao") or ""))
        self.ed_tecido.setText(str(molde.get("tecido") or "1"))
        self.sp_qtd_modelo.setValue(int(molde.get("qtd_modelo", 1) or 1))
        self.chk_par.setChecked(bool(molde.get("par", False)))
        self.chk_mostrar_nome.setChecked(bool(molde.get("mostrar_nome", True)))
        self.chk_mostrar_fio.setChecked(bool(molde.get("mostrar_fio", True)))
        self.chk_mostrar_numeros.setChecked(bool(molde.get("mostrar_numeros", False)))
        self.chk_visual_descricao.setChecked(bool(molde.get("visual_descricao", False)))
        self.chk_quantidade_visual.setChecked(bool(molde.get("visual_quantidade", True)))
        self.chk_preencher.setChecked(bool(molde.get("visual_preencher", False)))
        self._cor_visual = str(molde.get("cor") or "#58dfe3")
        self.btn_cor_preenchimento.setStyleSheet(f"background:{self._cor_visual}; border:1px solid #8a939c; padding:0;")

        self._atualizar_mapa()
        self.preview.set_molde(dict(molde) if molde else None)

    def _aplicar(self) -> bool:
        molde = self._molde_atual()
        if not molde:
            # Criar um molde padrão se não existir
            if self._indice_atual is None:
                self._indice_atual = 0
            molde = {
                "molde": True,
                "tipo": "polyline",
                "pontos": [(100, 100), (200, 100), (200, 200), (100, 200), (100, 100)],
            }
            if len(self.canvas.cena.elementos) <= self._indice_atual:
                self.canvas.cena.elementos.append(molde)
            else:
                self.canvas.cena.elementos[self._indice_atual] = molde

        molde["nome_molde"] = self.ed_nome.text().strip() or "N22"
        molde["descricao"] = self.ed_descricao.text().strip()
        molde["tecido"] = self.ed_tecido.text().strip()
        molde["qtd_modelo"] = int(self.sp_qtd_modelo.value())
        molde["par"] = self.chk_par.isChecked()
        molde["refletido_vertical"] = self.chk_reflete_v.isChecked()
        molde["refletido_horizontal"] = self.chk_reflete_h.isChecked()
        molde["mostrar_nome"] = self.chk_mostrar_nome.isChecked()
        molde["mostrar_fio"] = self.chk_mostrar_fio.isChecked()
        molde["mostrar_numeros"] = self.chk_mostrar_numeros.isChecked()
        molde["visual_descricao"] = self.chk_visual_descricao.isChecked()
        molde["visual_quantidade"] = self.chk_quantidade_visual.isChecked()
        molde["visual_preencher"] = self.chk_preencher.isChecked()
        molde["cor"] = self._cor_visual

        self.canvas.update()
        if hasattr(self.canvas, "_registrar_historico"):
            self.canvas._registrar_historico()
        self.preview.set_molde(dict(molde))
        self._atualizar_mapa()
        self.dados_aplicados.emit()
        return True

    def _ok(self):
        if self._aplicar():
            self.close()

    def _excluir_molde_atual(self):
        if self._indice_atual is not None and 0 <= self._indice_atual < len(self.canvas.cena.elementos):
            del self.canvas.cena.elementos[self._indice_atual]
            if hasattr(self.canvas, "_registrar_historico"):
                self.canvas._registrar_historico()
            self.canvas.update()
        self._indice_atual = None
        self.recarregar_lista()

    def _escolher_cor(self):
        cor = QColorDialog.getColor(QColor(self._cor_visual), self, "Cor do molde")
        if not cor.isValid():
            return
        self._cor_visual = cor.name()
        self.btn_cor_preenchimento.setStyleSheet(f"background:{self._cor_visual}; border:1px solid #8a939c; padding:0;")
        molde = self._molde_atual()
        if molde:
            clone = dict(molde)
            clone["cor"] = self._cor_visual
            self.preview.set_molde(clone)


class Ferramenta(FerramentaBase):
    id_ferramenta = "propriedades"
    nome = "Propriedades"
    descricao_painel = "Abre a janela de propriedades dos moldes selecionados."

    _dialog_por_canvas: dict[int, PropriedadesMoldesDialog] = {}

    def on_activate(self, canvas):
        super().on_activate(canvas)
        dialog = self._obter_dialog(canvas)
        dialog.recarregar_lista()
        dialog.show()
        dialog.raise_()
        dialog.activateWindow()
        self.set_status("Janela de propriedades do molde aberta.")

    def _obter_dialog(self, canvas) -> PropriedadesMoldesDialog:
        chave = id(canvas)
        dialog = self._dialog_por_canvas.get(chave)
        if dialog is not None:
            return dialog
        parent = canvas.window() if hasattr(canvas, "window") else None
        dialog = PropriedadesMoldesDialog(canvas, parent)
        dialog.dados_aplicados.connect(lambda: self.set_status("Propriedades do molde aplicadas."))
        self._dialog_por_canvas[chave] = dialog
        return dialog